# ============================================================
# Ritmo — configuração do backend (copie para .env)
# Requisito travado: nada de segredo/valor no código, tudo por env var
# ============================================================

# Banco — Postgres (AD-007): o do compose roda em localhost:5432.
# Dentro do compose o backend usa o hostname `postgres` (via environment do serviço).
DATABASE_URL=postgresql+psycopg://ritmo:ritmo@localhost:5432/ritmo

# NVIDIA NIM — chave do build.nvidia.com (mesma conta usada no OpenCode)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3
# Timeout da chamada de avaliação em segundos (glm-5.3 raciocina além de 120s)
# NVIDIA_TIMEOUT_S=420
# LTHR de referência (bpm) para a avaliação interpretar FC — recalibração sobrepõe
# LTHR_BPM=177

# Garmin — tokens OAuth já existentes (os mesmos usados pelo garmin_mcp)
GARMINTOKENS=~/.garminconnect
GARMINTOKENS_BASE64=~/.garminconnect_base64

# Garmin sync — janelas, cadência e guard rails (spec do garmin-sync)
# Re-pull em steady-state: Garmin reprocessa sono/carga por até 72h (SYNC-10/18)
SYNC_REPULL_DAYS=3
# Primeiro sync (backfill): 180d de atividades, 120d de saúde (SYNC-15/HRV-15:
# exibição 60d + lookback de banda de 59d)
SYNC_BACKFILL_ACTIVITIES_DAYS=180
SYNC_BACKFILL_HEALTH_DAYS=120
# Pausa mínima entre chamadas sequenciais — nunca rajadas (SYNC-03)
SYNC_CALL_INTERVAL_S=1.0
# Guard rail contra runaway de chamadas (SYNC-09)
SYNC_MAX_CALLS=1500
# Retries com backoff exponencial 2s/4s/8s (SYNC-07)
SYNC_RETRY_MAX=3

# App
APP_ENV=dev
# Caminho do arquivo de zonas VDOT (default data/vdot_zones.json)
# VDOT_ZONES_PATH=data/vdot_zones.json
# CORS — origens explícitas separadas por vírgula (AUTH-28): com cookies
# credenciados o browser rejeita "*". Para acesso via IP da LAN (mesmo host
# do frontend — constraint do cookie host-only), adicione a origem:
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://192.168.15.16:3000

# Auth — convite e sessão (feature auth): INVITE_CODE vazio = registro
# desabilitado (403); ligue só quando o user-scope estiver no ar
INVITE_CODE=
# Sessão sliding: TTL 30d, renovada quando restam ≤15d
SESSION_TTL_DAYS=30
SESSION_RENEW_THRESHOLD_DAYS=15
# Cookie host-only HttpOnly; Secure exige HTTPS (Fase 2.5)
SESSION_COOKIE_NAME=ritmo_session
SESSION_COOKIE_SECURE=false

# Fuso da conversão de deitar/acordar do painel Saúde (default America/Sao_Paulo)
# APP_TIMEZONE=America/Sao_Paulo
