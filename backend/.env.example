# ============================================================
# Ritmo — configuração do backend (copie para .env)
# Requisito travado: nada de segredo/valor no código, tudo por env var
# ============================================================

# Banco — Postgres (AD-007): o do compose roda em localhost:5432.
# Dentro do compose o backend usa o hostname `postgres` (via environment do serviço).
DATABASE_URL=postgresql+psycopg://ritmo:ritmo@localhost:5432/ritmo

# NVIDIA NIM — chave do build.nvidia.com (mesma conta usada no OpenCode)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3

# Garmin — tokens OAuth já existentes (os mesmos usados pelo garmin_mcp)
GARMINTOKENS=~/.garminconnect
GARMINTOKENS_BASE64=~/.garminconnect_base64

# Garmin sync — janelas, cadência e guard rails (spec do garmin-sync)
# Re-pull em steady-state: Garmin reprocessa sono/carga por até 72h (SYNC-10/18)
SYNC_REPULL_DAYS=3
# Primeiro sync (backfill): 180d de atividades, 60d de saúde (SYNC-15)
SYNC_BACKFILL_ACTIVITIES_DAYS=180
SYNC_BACKFILL_HEALTH_DAYS=60
# Pausa mínima entre chamadas sequenciais — nunca rajadas (SYNC-03)
SYNC_CALL_INTERVAL_S=1.0
# Guard rail contra runaway de chamadas (SYNC-09)
SYNC_MAX_CALLS=1500
# Retries com backoff exponencial 2s/4s/8s (SYNC-07)
SYNC_RETRY_MAX=3

# App
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000
