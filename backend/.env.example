# ============================================================
# Ritmo — configuração do backend (copie para .env)
# Requisito travado: nada de segredo/valor no código, tudo por env var
# ============================================================

# Banco — Postgres (AD-007): o do compose roda em localhost:5432.
# Dentro do compose o backend usa o hostname `postgres` (via environment do serviço).
DATABASE_URL=postgresql+psycopg://ritmo:ritmo@localhost:5432/ritmo

# NVIDIA NIM — chave do build.nvidia.com (mesma conta usada no OpenCode)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3

# Garmin — tokens OAuth já existentes (os mesmos usados pelo garmin_mcp)
GARMINTOKENS=~/.garminconnect
GARMINTOKENS_BASE64=~/.garminconnect_base64

# App
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000
